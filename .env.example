# Supabase — Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

# Public URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — safe to expose in the browser (used by client-side reads)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SERVER ONLY, never expose to the browser
# Used by API routes (/api/newsletter, /api/orders) to write with elevated privileges
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
